# ---------------------------------------------------------------------------
# Universal Rubber Stamp — environment example
# Copy to `.env` and adjust. All values below are safe defaults.
# Client-side (Vite) variables MUST be prefixed with VITE_.
# ---------------------------------------------------------------------------

# API base URL for the optional backend document-processing layer.
# Leave blank to run in 100% local / privacy-first mode (recommended default).
VITE_API_BASE_URL=

# Master switch: process documents locally in the browser whenever possible.
# When true, documents never leave the device. When false, heavy formats can
# be sent to VITE_API_BASE_URL for server-side processing.
VITE_PROCESS_LOCALLY=true

# Maximum upload size (MB) accepted by the client validation layer.
VITE_MAX_FILE_SIZE_MB=50

# Enable verbose client logging (keep false in production).
VITE_DEBUG=false

# ---- Backend (FastAPI) only — used when server processing is enabled ----
# Copy backend/.env.example to backend/.env for server settings.
